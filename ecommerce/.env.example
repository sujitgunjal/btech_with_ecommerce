# Copy to .env beside docker-compose.yml and change the secrets.
# Fault injection stays off until you set the flag, an operator name, and a password.

APP_ENV=development
FAULT_INJECTION_ENABLED=false
JWT_SECRET=replace-with-a-long-random-string
PAYMENT_SHARED_SECRET=replace-with-a-payment-secret
INTERNAL_FAULT_TOKEN=replace-with-an-internal-token
OPS_USERNAME=admin
OPS_PASSWORD=admin
PAYMENT_TIMEOUT_SECONDS=2
CORS_ORIGINS=http://localhost:5174,http://localhost:8088
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
DEPLOYMENT_ENVIRONMENT=development
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=2
