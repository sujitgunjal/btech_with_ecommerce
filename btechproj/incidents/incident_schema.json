{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident scenario ground truth",
  "type": "object",
  "required": ["incident_id", "type", "affected_service", "start_time", "end_time", "expected_root_cause", "expected_symptoms", "severity"],
  "properties": {
    "incident_id": { "type": "string", "pattern": "^INC-[0-9]{3}$" },
    "type": { "type": "string", "enum": ["database_failure", "service_failure", "high_latency", "cpu_spike", "memory_spike", "bad_deployment", "network_failure"] },
    "affected_service": { "type": "string", "minLength": 1 },
    "start_time": { "type": "string", "format": "date-time" },
    "end_time": { "type": "string", "format": "date-time" },
    "expected_root_cause": { "type": "string", "minLength": 1 },
    "expected_symptoms": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] }
  }
}
