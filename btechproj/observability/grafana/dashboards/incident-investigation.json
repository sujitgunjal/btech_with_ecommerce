{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (service_name) (rate(app_http_request_count_total[1m]))", "legendFormat": "{{service_name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "title": "5xx error rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (service_name) (rate(app_http_error_count_total[1m]))", "legendFormat": "{{service_name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "continuous-GrYlRd"}}, "overrides": []}
    },
    {
      "title": "P95 request latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(app_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service_name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "title": "Container CPU",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"user-service|product-service|order-service\"}[5m])) * 100", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}
    },
    {
      "title": "Container memory",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (name) (container_memory_working_set_bytes{name=~\"user-service|product-service|order-service\"})", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "title": "Order-service errors in Loki",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{service_name=\"order-service\"} | level = \"ERROR\"", "refId": "A"}],
      "options": {"showTime": true, "sortOrder": "Descending", "wrapLines": true}
    }
  ],
  "schemaVersion": 39,
  "tags": ["devops", "observability", "incident-investigation"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "AI Incident Investigation - Observability",
  "uid": "ai-incident-observability",
  "version": 1
}
